GITHUB_TOKEN=ghp_your_token_here

# Which Ollama model to use for triage. Must be already pulled locally.
# Recommended: llama3.1:8b  (fast, good quality, 4.7 GB)
# Alternative: mistral:7b   (slightly smaller, comparable quality)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant connection — default matches the docker-compose service
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=resolv_issues

# SQLite database path (relative to repo root)
SQLITE_PATH=backtest/data/resolv.db

# How many similar issues to retrieve per triage query
TOP_K=10

# Embedding model — change to all-mpnet-base-v2 for higher quality (2x slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding device — defaults to 'cpu' to avoid competing with Ollama for GPU memory.
# On M2 Air (8 GB unified RAM), llama3.1:8b uses ~5 GB, leaving no room for MPS.
# Set to 'mps' only if you are running batch indexing WITHOUT Ollama running.
# EMBEDDING_DEVICE=mps
