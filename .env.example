GITHUB_TOKEN=ghp_your_token_here

# Which Ollama model to use for triage. Must be already pulled locally.
# Recommended: llama3.1:8b  (fast, good quality, 4.7 GB)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant connection — default matches the docker-compose service
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resolv_issues

# Embedding model — uses the same Ollama model as the LLM
EMBEDDING_MODEL=llama3.1:8b

# SQLite database path (relative to repo root)
SQLITE_PATH=backtest/data/resolv.db

# How many similar issues to retrieve per triage query
TOP_K=10

# GitHub App credentials
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./your-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting — token bucket per repository
# RATE_LIMIT_TOKENS: max burst of events per repo before throttling
# RATE_LIMIT_REFILL_SEC: seconds to fully refill the bucket from 0
RATE_LIMIT_TOKENS=10
RATE_LIMIT_REFILL_SEC=60
